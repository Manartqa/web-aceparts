# Copy to .env.local and fill in. Never commit real values.

# Public origin for canonical URLs, Open Graph, sitemap.xml and JSON-LD.
# Read at build time. Defaults to https://aceparts.co.th.
NEXT_PUBLIC_SITE_URL=https://aceparts.co.th
# 1 = staging: robots.txt disallows everything and every page is noindex. Build time.
NEXT_PUBLIC_NOINDEX=

# --- Contact form: Gmail API (Google Workspace service account) ------------
# The service account needs domain-wide delegation for
# https://www.googleapis.com/auth/gmail.send only. Both values come from its JSON key
# (client_email, private_key). Keep the key's \n escapes and the double quotes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Workspace user the enquiry is sent as. Must have a Gmail licence.
MAIL_SENDER=admin@acethailand.co.th
# Where enquiries are delivered. Comma-separated for several recipients.
CONTACT_MAIL_TO=operations@acethailand.co.th
