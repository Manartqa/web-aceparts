# Copy to .env.local and fill in. Never commit real values.

# Public origin for canonical URLs, Open Graph, sitemap.xml and JSON-LD.
# Read at build time. Defaults to https://aceparts.co.th.
NEXT_PUBLIC_SITE_URL=https://aceparts.co.th

# --- Contact form: Microsoft Graph sendMail (Entra ID app-only) -----------
# The App Registration needs the Mail.Send application permission with admin consent.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Mailbox the enquiry is sent as. Must exist in the tenant.
MAIL_SENDER=operations@acethailand.co.th
# Where enquiries are delivered. Comma-separated for several recipients.
CONTACT_MAIL_TO=operations@acethailand.co.th
